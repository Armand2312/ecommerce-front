# Copy to .env.local and fill in your own credentials. Never commit real values.
# MongoDB database used by the demo storefront and its admin project.
MONGODB_URI=

# Stripe test secret key only (sk_test_...). Live/restricted keys are rejected.
STRIPE_SK=

# Test-mode webhook signing secret (whsec_...) for /api/webhooks/stripe.
# Local Stripe CLI and Vercel endpoints have different signing secrets.
WEBHOOK_SK=

# Local origin; use your exact HTTPS storefront origin on Vercel.
PUBLIC_URL=http://localhost:3000
